<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    logicalFilePath="db/changelog/changesets/003-regra-horario-schema.xml"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="003-regra-horario-schema" author="antigravity">

        <!-- ID Generators -->
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_REGRA"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_HORARIO"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>

        <!-- TB_REGRA -->
        <createTable tableName="TB_REGRA">
            <column name="ID_REGRA" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DATA_CRIACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ALTERACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="VERSAO" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>

            <column name="NOME" type="VARCHAR(255)"/>
            <column name="STATUS" type="VARCHAR(100)"/>
            <column name="VALIDADE" type="DATE"/>
            <column name="ID_EMPRESA" type="BIGINT"/>
            <column name="TIPO" type="VARCHAR(100)"/>
            <column name="TIPO_PEDESTRE" type="VARCHAR(100)"/>
            <column name="DESCRICAO" type="VARCHAR(255)"/>
            <column name="DATA_INICIO_PERIODO" type="DATE"/>
            <column name="DATA_FIM_PERIODO" type="DATE"/>
            <column name="TIPO_ESCALA" type="VARCHAR(100)"/>
            <column name="PERMITE_BLOQUEIO" type="BOOLEAN"/>
            <column name="HORARIO_INICIO_TURNO" type="DATETIME"/>
            <column name="QTDE_CREDITOS" type="BIGINT"/>
            <column name="DIAS_VALIDADE_CREDITO" type="BIGINT"/>
            <column name="ID_TEMPLATE" type="INT"/>
            <column name="ID_PLANO" type="INT"/>
            <column name="ID_ESCALA" type="INT"/>
            <column name="ID_CLIENTE" type="BIGINT"/>
        </createTable>

        <!-- TB_HORARIO -->
        <createTable tableName="TB_HORARIO">
            <column name="ID_HORARIO" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DATA_CRIACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ALTERACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="VERSAO" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>

            <column name="NOME" type="VARCHAR(255)"/>
            <column name="STATUS" type="VARCHAR(100)"/>
            <column name="ID_REGRA" type="BIGINT"/>
            <column name="ID_PEDESTRE_REGRA" type="BIGINT"/>
            <column name="DIAS_SEMANA" type="VARCHAR(100)"/>
            <column name="HORARIO_INI" type="DATETIME"/>
            <column name="HORARIO_FIM" type="DATETIME"/>
            <column name="QTDE_CREDITOS" type="BIGINT"/>
            <column name="ID_HORARIO_SENIOR" type="INT"/>
        </createTable>

        <!-- Foreign Keys -->
        <addForeignKeyConstraint baseTableName="TB_REGRA" baseColumnNames="ID_CLIENTE"
                                constraintName="FK_REGRA_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID_CLIENTE"/>
        <addForeignKeyConstraint baseTableName="TB_REGRA" baseColumnNames="ID_EMPRESA"
                                constraintName="FK_REGRA_EMPRESA" referencedTableName="TB_EMPRESA" referencedColumnNames="ID_EMPRESA"/>
        <addForeignKeyConstraint baseTableName="TB_HORARIO" baseColumnNames="ID_REGRA"
                                constraintName="FK_HORARIO_REGRA" referencedTableName="TB_REGRA" referencedColumnNames="ID_REGRA"/>

    </changeSet>

</databaseChangeLog>
