<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001-initial-schema" author="antigravity">

        <!-- Portable JPA TABLE generators: supported by MySQL, SQL Server, and other relational databases. -->
        <createTable tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="GEN_VALUE" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_CLIENTE"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_PLANO"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_USUARIO"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_PEDESTRE"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_PARAMETRO"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_ACESSO"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_ACESSO_SISTEMA"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>
        <insert tableName="TB_ID_GENERATOR">
            <column name="GEN_NAME" value="TB_WEB_PERFIL_PERMISSAO"/>
            <column name="GEN_VALUE" valueNumeric="0"/>
        </insert>

        <!-- TB_CLIENTE -->
        <createTable tableName="TB_CLIENTE">
            <column name="ID_CLIENTE" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DATA_CRIACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ALTERACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="VERSAO" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>
            
            <column name="NOME" type="VARCHAR(255)"/>
            <column name="EMAIL" type="VARCHAR(100)"/>
            <column name="CNPJ" type="VARCHAR(50)"/>
            <column name="TELEFONE" type="VARCHAR(30)"/>
            <column name="CELULAR" type="VARCHAR(30)"/>
            <column name="CONTATO" type="VARCHAR(255)"/>
            <column name="STATUS" type="VARCHAR(10)"/>
            <column name="UNIDADE_ORGANIZACIONAL" type="VARCHAR(60)"/>
        </createTable>

        <!-- TB_PLANO -->
        <createTable tableName="TB_PLANO">
            <column name="ID_PLANO" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DATA_CRIACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ALTERACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="VERSAO" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>
            
            <column name="NOME" type="VARCHAR(255)"/>
            <column name="STATUS" type="VARCHAR(10)"/>
            <column name="DATA_INICIO" type="DATETIME"/>
            <column name="DATA_FIM" type="DATETIME"/>
            <column name="PERIODICIDADE" type="VARCHAR(255)"/>
            <column name="DIA_VENCIMENTO" type="BIGINT"/>
            <column name="VALOR" type="DOUBLE"/>
            <column name="ID_CLIENTE" type="BIGINT"/>
        </createTable>

        <!-- TB_USUARIO -->
