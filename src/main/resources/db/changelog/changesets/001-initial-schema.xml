            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>
            
            <column name="PERFIL" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="CODIGO_PERMISSAO" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="HABILITADO" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="ID_CLIENTE" type="BIGINT"/>
        </createTable>

        <!-- Foreign Keys -->
        <addForeignKeyConstraint baseTableName="TB_PLANO" baseColumnNames="ID_CLIENTE" constraintName="FK_PLANO_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID_CLIENTE"/>
        <addForeignKeyConstraint baseTableName="TB_USUARIO" baseColumnNames="ID_CLIENTE" constraintName="FK_USUARIO_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID_CLIENTE"/>
        <addForeignKeyConstraint baseTableName="TB_PEDESTRE" baseColumnNames="ID_CLIENTE" constraintName="FK_PEDESTRE_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID_CLIENTE"/>
        <addForeignKeyConstraint baseTableName="TB_PARAMETRO" baseColumnNames="ID_CLIENTE" constraintName="FK_PARAMETRO_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID_CLIENTE"/>
        <addForeignKeyConstraint baseTableName="TB_ACESSO" baseColumnNames="ID_PEDESTRE" constraintName="FK_ACESSO_PEDESTRE" referencedTableName="TB_PEDESTRE" referencedColumnNames="ID_PEDESTRE"/>
        <addForeignKeyConstraint baseTableName="TB_ACESSO_SISTEMA" baseColumnNames="ID_USUARIO" constraintName="FK_ACESSOSYS_USUARIO" referencedTableName="TB_USUARIO" referencedColumnNames="ID_USUARIO"/>
        <addForeignKeyConstraint baseTableName="TB_ACESSO_SISTEMA" baseColumnNames="ID_PEDESTRE" constraintName="FK_ACESSOSYS_PEDESTRE" referencedTableName="TB_PEDESTRE" referencedColumnNames="ID_PEDESTRE"/>
        <addForeignKeyConstraint baseTableName="TB_WEB_PERFIL_PERMISSAO" baseColumnNames="ID_CLIENTE" constraintName="FK_WEBPERFIL_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID_CLIENTE"/>

        <!-- Unique Constraints -->
        <addUniqueConstraint tableName="TB_WEB_PERFIL_PERMISSAO" columnNames="ID_CLIENTE, PERFIL, CODIGO_PERMISSAO" constraintName="UK_WEB_PERFIL_PERMISSAO"/>

    </changeSet>

</databaseChangeLog>
