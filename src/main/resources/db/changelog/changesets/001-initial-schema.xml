            </column>
            <column name="DATA_ALTERACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="VERSAO" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>
            
            <column name="NOME" type="VARCHAR(255)"/>
            <column name="STATUS" type="VARCHAR(100)"/>
            <column name="LOGIN" type="VARCHAR(100)"/>
            <column name="SENHA" type="VARCHAR(255)"/>
            <column name="EMAIL" type="VARCHAR(100)"/>
            <column name="CPF" type="VARCHAR(20)"/>
            <column name="RG" type="VARCHAR(20)"/>
            <column name="TELEFONE" type="VARCHAR(20)"/>
            <column name="CELULAR" type="VARCHAR(20)"/>
            <column name="DATA_NASCIMENTO" type="DATETIME"/>
            <column name="PERFIL" type="VARCHAR(20)"/>
            <column name="TOKEN" type="VARCHAR(100)"/>
            <column name="ACESSA_WEB" type="BOOLEAN"/>
            <column name="CADASTRO_SIMPLES" type="BOOLEAN"/>
            <column name="USUARIO_MASTER" type="BOOLEAN"/>
            <column name="HABILITA_EXPEDIDORA" type="BOOLEAN"/>
            <column name="ID_CLIENTE" type="BIGINT"/>
        </createTable>

        <!-- TB_PEDESTRE -->
        <createTable tableName="TB_PEDESTRE">
            <column name="ID_PEDESTRE" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DATA_CRIACAO" type="DATETIME">
