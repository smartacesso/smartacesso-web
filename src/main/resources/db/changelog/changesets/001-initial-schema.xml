            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>
            
            <column name="NOME" type="VARCHAR(255)"/>
            <column name="VALOR" type="VARCHAR(255)"/>
            <column name="ID_CLIENTE" type="BIGINT"/>
        </createTable>

        <!-- TB_ACESSO -->
        <createTable tableName="TB_ACESSO">
            <column name="ID_ACESSO" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DATA_CRIACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ALTERACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="VERSAO" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REMOVIDO" type="CHAR(1)"/>
            <column name="DATA_REMOVIDO" type="DATETIME"/>
            <column name="UNIQUE_ID" type="VARCHAR(36)"/>
            
            <column name="ID_PEDESTRE" type="BIGINT"/>
            <column name="DATA" type="DATETIME"/>
            <column name="SENTIDO" type="VARCHAR(100)"/>
            <column name="EQUIPAMENTO" type="VARCHAR(100)"/>
            <column name="TIPO" type="VARCHAR(100)"/>
