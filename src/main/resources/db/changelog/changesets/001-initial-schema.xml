        </createTable>

        <!-- TB_PARAMETRO -->
        <createTable tableName="TB_PARAMETRO">
            <column name="ID_PARAMETRO" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DATA_CRIACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ALTERACAO" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="VERSAO" type="INT" defaultValueNumeric="0">
